{
  "connector.class": "io.littlehorse.connect.CorrelatedEventSinkConnector",
  "tasks.max": "1",
  "topics": "fulfillment-events",
  "key.converter": "org.apache.kafka.connect.storage.StringConverter",
  "value.converter": "org.apache.kafka.connect.json.JsonConverter",
  "value.converter.schemas.enable": "false",
  "lhc.api.host": "littlehorse",
  "lhc.api.port": "2024",
  "lhc.api.protocol": "PLAINTEXT",
  "lhc.tenant.id": "default",
  "external.event.name": "replacement-delivered",
  "consumer.override.auto.offset.reset": "earliest",
  "transient.errors.tolerance": "transients",
  "errors.tolerance": "none"
}
